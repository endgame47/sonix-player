#!/bin/sh
#
# wlbt-wifi up|down -- Wi-Fi with bcm_wlbt_power and brcmfmac.
#
#   up    powers the chip, points the firmware loader at the stock blob for
#         the module maker, loads brcmfmac and waits for the interface; then
#         gives it the stock MAC address through S43wifi_bcm_init_config, when
#         that script is there
#   down  takes the interface down, unloads brcmfmac and powers the chip down
#
# Exits 0 without doing anything where bcm_wlbt_power is not loaded, so the
# stock wifi_on.sh and wifi_off.sh can call it unconditionally.

RADIO=/sys/devices/platform/bcm_wlbt_power
IFACE=${WLBT_IFACE:-wlan0}
MODDIR=${WLBT_MODDIR:-/module_driver}
FWSRC=${WLBT_FWSRC:-/lib/firmware/wifi_bcm}
FWDIR=/tmp/brcmfmac
SCAN_ASSOC_TIME=${BRCMFMAC_SCAN_ASSOC_TIME:-20}
case "$SCAN_ASSOC_TIME" in
	1[0-9]|2[0-9]|3[0-9]|40) ;;
	*)
		echo "wlbt-wifi: invalid BRCMFMAC_SCAN_ASSOC_TIME '$SCAN_ASSOC_TIME'; using 20" >&2
		SCAN_ASSOC_TIME=20
		;;
esac
MAC_SCRIPT=/etc/init.d/S43wifi_bcm_init_config

[ -e $RADIO/wifi_power ] || exit 0

wifi_down() {
	[ -e /sys/class/net/$IFACE ] && ifconfig $IFACE down
	# A driver that will not unload keeps the power, or it would lose the
	# chip under it.
	if [ -d /sys/module/brcmfmac ] && ! rmmod brcmfmac; then
		return 1
	fi
	[ -d /sys/module/brcmutil ] && rmmod brcmutil
	echo 0 > $RADIO/wifi_power
}

wifi_up() {
	echo 1 > $RADIO/wifi_power || return 1

	# The blob goes with the module maker, as the stock cywdhd chooses it:
	# AzureWave AW-NB372SM (chipvendor 0x81) or AP6212A. brcmfmac asks for
	# brcm/brcmfmac43430-sdio.* in the firmware search path, which FWDIR is
	# put in front of.
	case "$(cat $RADIO/chipvendor)" in
	0x81) fw=cyw43438-7.46.58.35.bin; nv=nvram_azw372.txt ;;
	*)    fw=fw_bcm43438a1.bin;       nv=nvram_ap6212a.txt ;;
	esac
	mkdir -p $FWDIR/brcm
	ln -sf $FWSRC/$fw $FWDIR/brcm/brcmfmac43430-sdio.bin
	ln -sf $FWSRC/$nv $FWDIR/brcm/brcmfmac43430-sdio.txt
	echo -n $FWDIR > /sys/module/firmware_class/parameters/path

	[ -d /sys/module/brcmutil ] || insmod $MODDIR/brcmutil.ko || return 1
	[ -d /sys/module/brcmfmac ] || insmod $MODDIR/brcmfmac.ko scan_assoc_time="$SCAN_ASSOC_TIME" || return 1

	# The interface appears once the firmware is in the chip, after insmod
	# returns.
	count=0
	while [ ! -e /sys/class/net/$IFACE ]; do
		[ $count -ge 100 ] && return 1
		count=$((count + 1))
		usleep 50000
	done

	[ -x $MAC_SCRIPT ] && $MAC_SCRIPT start
	return 0
}

case "$1" in
up)
	if ! wifi_up; then
		echo "wlbt-wifi: Wi-Fi did not come up" >&2
		wifi_down
		exit 1
	fi
	;;
down)
	wifi_down
	;;
*)
	echo "usage: $0 up|down" >&2
	exit 2
	;;
esac
